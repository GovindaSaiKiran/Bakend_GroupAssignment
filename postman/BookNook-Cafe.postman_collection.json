    {
      "name": "3. Bookings",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"guestName\": \"Rahul\",\n  \"gameName\": \"Catan\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test(\"Booking created with guest and game\", function () {",
                  "    pm.expect(jsonData.guestName).to.eql(\"Rahul\");",
                  "    pm.expect(jsonData.gameName).to.eql(\"Catan\");",
                  "    pm.expect(jsonData.returned).to.eql(false);",
                  "});",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set(\"demoBookingId\", jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get All Bookings (SQL JOIN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Bookings include guestName and gameName via SQL JOIN\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    if (jsonData.length > 0) {",
                  "        pm.expect(jsonData[0]).to.have.property('guestName');",
                  "        pm.expect(jsonData[0]).to.have.property('gameName');",
                  "        pm.expect(jsonData[0]).to.have.property('returned');",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Special Return Flow Twist",
      "item": [
        {
          "name": "Test 1: First Return (Expected 200 OK)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{demoBookingId}}/return",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "{{demoBookingId}}", "return"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Test 1 Passed: Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Message confirms booking returned successfully\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.eql(\"Booking returned successfully\");",
                  "    pm.expect(jsonData.bookingId).to.be.a(\"number\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Test 2: Second Return (Expected 409 Conflict)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{demoBookingId}}/return",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "{{demoBookingId}}", "return"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Test 2 Passed: Status code is 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"Message is exactly 'Already returned'\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.eql(\"Already returned\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Test 3: Guest Return History (Expected 200 OK)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/guests/1/history",
              "host": ["{{baseUrl}}"],
              "path": ["guests", "1", "history"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Test 3 Passed: Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returned booking is listed in guest history\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    pm.expect(jsonData.length).to.be.above(0);",
                  "    const returnedItem = jsonData[0];",
                  "    pm.expect(returnedItem).to.have.property('bookingId');",
                  "    pm.expect(returnedItem).to.have.property('guestName');",
                  "    pm.expect(returnedItem).to.have.property('gameName');",
                  "    pm.expect(returnedItem.returned).to.eql(true);",
                  "    pm.expect(returnedItem).to.have.property('returnDate');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
