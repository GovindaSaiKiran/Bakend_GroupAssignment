        {
          "name": "Search Games By Players (Query Param)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/games?players=2",
              "host": ["{{baseUrl}}"],
              "path": ["games"],
              "query": [
                {
                  "key": "players",
