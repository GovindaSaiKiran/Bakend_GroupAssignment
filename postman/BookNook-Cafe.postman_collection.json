                  "});",
                  "pm.test(\"All returned games have players = 2\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    jsonData.forEach(game => {",
                  "        pm.expect(game.players).to.eql(2);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
