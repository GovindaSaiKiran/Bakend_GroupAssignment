      "type": "string"
    },
    {
      "key": "demoBookingId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Guests",
      "item": [
        {
          "name": "Get All Guests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/guests",
              "host": ["{{baseUrl}}"],
              "path": ["guests"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns array of guests\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
